{
  "name": "Android Kotlin",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "ANDROID_API": "35",
      "ANDROID_BUILD_TOOLS": "35.0.0"
    }
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "fwcd.kotlin",
        "vscjava.vscode-gradle"
      ]
    }
  }
}